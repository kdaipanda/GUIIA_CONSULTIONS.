{
  "appId": "vet.guiaa.app",
  "appName": "GUIAA",
  "webDir": "build",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0c2d4d",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#0c2d4d"
    },
    "Keyboard": {
      "resize": "none",
      "resizeOnFullScreen": true
    }
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0c2d4d"
  }
}
